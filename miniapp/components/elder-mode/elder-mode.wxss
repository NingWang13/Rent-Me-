.elder-container {
  display: flex;
  align-items: center;
}

.elder-toggle {
  padding: 16rpx 24rpx;
  background-color: #fff7e6;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
}

.toggle-text {
  font-size: 24rpx;
  color: #faad14;
}

.elder-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: #faad14;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.elder-text {
  font-size: 26rpx;
  color: #faad14;
}

.elder-arrow {
  font-size: 28rpx;
  color: #faad14;
  margin-left: 8rpx;
}