.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  min-height: 400rpx;
  width: 100%;
  box-sizing: border-box;
}

.empty-state__icon {
  margin-bottom: 30rpx;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state__icon-image {
  width: 100%;
  height: 100%;
  opacity: 0.6;
}

.empty-state__icon-text {
  font-size: 100rpx;
  color: #cccccc;
  line-height: 1;
}

.empty-state__content {
  text-align: center;
  width: 100%;
  max-width: 600rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.empty-state__title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  line-height: 1.4;
  word-wrap: break-word;
}

.empty-state__desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 40rpx;
  word-wrap: break-word;
}

.empty-state__actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.empty-state__action-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #ffffff;
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.empty-state__action-btn::after {
  border: none;
}

.empty-state__action-btn--primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #845EF7 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
}

.empty-state__action-btn--primary:active {
  background: linear-gradient(135deg, #E55555 0%, #7048D8 100%);
}

.empty-state__action-btn:active {
  opacity: 0.85;
}

@media screen and (max-width: 375px) {
  .empty-state {
    padding: 60rpx 30rpx;
    min-height: 350rpx;
  }

  .empty-state__icon {
    width: 120rpx;
    height: 120rpx;
    margin-bottom: 20rpx;
  }

  .empty-state__icon-text {
    font-size: 80rpx;
  }

  .empty-state__title {
    font-size: 28rpx;
  }

  .empty-state__desc {
    font-size: 24rpx;
    margin-bottom: 30rpx;
  }

  .empty-state__action-btn {
    height: 72rpx;
    line-height: 72rpx;
    font-size: 26rpx;
  }
}

@media screen and (min-width: 768px) {
  .empty-state {
    padding: 100rpx 60rpx;
    min-height: 500rpx;
  }

  .empty-state__icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
  }

  .empty-state__icon-text {
    font-size: 120rpx;
  }

  .empty-state__title {
    font-size: 36rpx;
  }

  .empty-state__desc {
    font-size: 28rpx;
    margin-bottom: 50rpx;
  }

  .empty-state__actions {
    flex-direction: row;
    justify-content: center;
    gap: 30rpx;
  }

  .empty-state__action-btn {
    width: auto;
    min-width: 200rpx;
    padding: 0 40rpx;
  }
}

