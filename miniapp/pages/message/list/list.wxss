.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tabs {
  display: flex;
  flex: 1;
}

.tab {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #1890ff;
  font-weight: 600;
}

.mark-read {
  font-size: 26rpx;
  color: #1890ff;
}

.message-list {
  padding: 20rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.message-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.message-item.unread {
  background-color: #f0f7ff;
}

.message-icon {
  margin-right: 24rpx;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.icon-box.type-1 {
  background-color: #1890ff;
}

.icon-box.type-2 {
  background-color: #52c41a;
}

.icon-box.type-3 {
  background-color: #faad14;
}

.icon-box.type-4 {
  background-color: #722ed1;
}

.icon-box.type-5 {
  background-color: #eb2f96;
}

.message-content {
  flex: 1;
}

.message-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.message-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.message-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.unread-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}