page {
  --primary: #FF6B6B;
  --primary-light: #FF8E8E;
  --primary-dark: #E55555;
  --secondary: #845EF7;
  --accent-green: #38D9A9;
  --accent-blue: #4DABF7;
  --accent-orange: #FFA94D;
  --bg: #F8F9FA;
  --card: #FFFFFF;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --text-tertiary: #B2BEC3;
  --border: #F1F3F5;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 40rpx;
}

.setting-section {
  margin: 24rpx 32rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.section-title {
  padding: 28rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border);
  line-height: 1.3;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
  margin-right: 24rpx;
}

.setting-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

switch {
  transform: scale(0.8);
}

.preview-section {
  margin: 24rpx 32rpx;
}

.preview-section .section-title {
  padding: 0 0 20rpx;
  border-bottom: none;
}

.preview-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.preview-card.large {
  padding: 48rpx;
}

.preview-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.2;
}

.preview-title.large {
  font-size: 44rpx;
}

.preview-content {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.preview-content.large {
  font-size: 36rpx;
}

.preview-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  line-height: 1;
}

.preview-btn.large {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 36rpx;
  line-height: 1;
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(100% - 64rpx);
  margin: 40rpx 32rpx;
  height: 88rpx;
  background: var(--card);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
  line-height: 1;
}

.tips-section {
  margin: 0 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(132, 94, 247, 0.05) 0%, rgba(77, 171, 247, 0.05) 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(132, 94, 247, 0.1);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--secondary);
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.tips-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}