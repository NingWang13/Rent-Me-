<nav-bar title="个人中心" />
<view class="container">
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="not-login-container" wx:elif="{{!isLogin}}">
    <view class="avatar-placeholder">
      <text class="avatar-icon">👤</text>
    </view>
    <text class="not-login-text">未登录</text>
    <button class="login-btn" bindtap="goToLogin">立即登录</button>
  </view>

  <view wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-info" bindtap="goToUserProfile">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" />
        <view class="user-details">
          <text class="user-name">{{userInfo.nickname || '用户' + userInfo.id}}</text>
          <text class="user-id">ID: {{userInfo.id}}</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="user-stats">
        <view class="stat-item" bindtap="goToCreditRecords">
          <text class="stat-value">{{userInfo.creditScore || 0}}</text>
          <text class="stat-label">积分</text>
        </view>
        <view class="stat-item" bindtap="goToMyWishes">
          <text class="stat-value">{{stats.wishCount || 0}}</text>
          <text class="stat-label">我的心愿</text>
        </view>
        <view class="stat-item" bindtap="goToMyOrders">
          <text class="stat-value">{{stats.orderCount || 0}}</text>
          <text class="stat-label">我的订单</text>
        </view>
        <view class="stat-item" bindtap="goToMyGroups">
          <text class="stat-value">{{stats.groupCount || 0}}</text>
          <text class="stat-label">我的群组</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="menu-title">我的服务</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToMyWishes">
          <view class="menu-icon-box wish-icon">
            <text class="menu-icon-text">❤</text>
          </view>
          <text class="menu-label">我的心愿</text>
          <text class="menu-badge" wx:if="{{stats.pendingWishCount > 0}}">{{stats.pendingWishCount}}</text>
          <text class="arrow-icon">></text>
        </view>
        <view class="menu-item" bindtap="goToMyOrders">
          <view class="menu-icon-box order-icon">
            <text class="menu-icon-text">📋</text>
          </view>
          <text class="menu-label">我的订单</text>
          <text class="menu-badge" wx:if="{{stats.pendingOrderCount > 0}}">{{stats.pendingOrderCount}}</text>
          <text class="arrow-icon">></text>
        </view>
        <view class="menu-item" bindtap="goToCreditRecords">
          <view class="menu-icon-box credit-icon">
            <text class="menu-icon-text">💰</text>
          </view>
          <text class="menu-label">积分记录</text>
          <text class="arrow-icon">></text>
        </view>
        <view class="menu-item" bindtap="goToMyGroups">
          <view class="menu-icon-box group-icon">
            <text class="menu-icon-text">👥</text>
          </view>
          <text class="menu-label">我的群组</text>
          <text class="arrow-icon">></text>
        </view>
      </view>
    </view>

    <view class="menu-section">
      <view class="menu-title">设置</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToAccessibility">
          <view class="menu-icon-box setting-icon">
            <text class="menu-icon-text">♿</text>
          </view>
          <text class="menu-label">无障碍设置</text>
          <text class="arrow-icon">></text>
        </view>
        <view class="menu-item" bindtap="goToFeedback">
          <view class="menu-icon-box feedback-icon">
            <text class="menu-icon-text">📝</text>
          </view>
          <text class="menu-label">意见反馈</text>
          <text class="arrow-icon">></text>
        </view>
        <view class="menu-item" bindtap="goToSettings">
          <view class="menu-icon-box setting-icon">
            <text class="menu-icon-text">⚙️</text>
          </view>
          <text class="menu-label">设置</text>
          <text class="arrow-icon">></text>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <button class="logout-btn" bindtap="logout">退出登录</button>
    </view>
  </view>
</view>
