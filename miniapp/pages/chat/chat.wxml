<nav-bar title="{{friendName}}" showBack="{{true}}" />
<view class="container">
  <view class="chat-container">
    <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollToViewId}}" scroll-with-animation>
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.senderId === currentUserId ? 'mine' : 'other'}}">
        <view class="message-bubble">
          <view class="message-avatar" style="background: {{item.senderAvatarColor}}"></view>
          <view class="message-content">
            <text class="message-text">{{item.content}}</text>
            <text class="message-time">{{item.time}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="input-area">
      <input class="message-input" 
             value="{{inputValue}}" 
             bindinput="onInput" 
             bindconfirm="onSend" 
             placeholder="输入消息..." 
             confirm-type="send" />
      <view class="send-btn" bindtap="onSend">
        <text class="btn-text">发送</text>
      </view>
    </view>
  </view>
</view>
