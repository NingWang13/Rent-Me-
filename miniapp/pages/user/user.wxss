page {
  --primary: #FF6B6B;
  --primary-light: #FF8E8E;
  --primary-dark: #E55555;
  --secondary: #845EF7;
  --accent-green: #38D9A9;
  --accent-blue: #4DABF7;
  --accent-orange: #FFA94D;
  --bg: #F8F9FA;
  --card: #FFFFFF;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --text-tertiary: #B2BEC3;
  --border: #F1F3F5;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
}

.profile-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  padding: 60rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.profile-header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.info-content {
  flex: 1;
}

.nickname-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 12rpx;
  line-height: 1.2;
}

.vip-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: var(--radius-xl);
}

.vip-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1;
}

.id-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-xl);
  font-size: 22rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  line-height: 1;
}

.edit-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  line-height: 1;
}

.stats-bar {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  line-height: 1;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.2);
}

.elder-mode-banner {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, var(--accent-green) 0%, #20C997 100%);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(56, 217, 169, 0.3);
}

.elder-toggle {
  display: flex;
  align-items: center;
}

.elder-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  margin-right: 16rpx;
  line-height: 1;
}

.elder-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1.2;
}

.elder-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1;
}

.order-section {
  margin: 24rpx 32rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.see-all {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
  line-height: 1;
}

.order-status-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--secondary) 100%);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.status-icon .iconfont {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 2rpx solid var(--card);
  line-height: 1;
}

.menu-section {
  margin: 0 32rpx;
}

.menu-group {
  background: var(--card);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1;
}

.menu-group:nth-child(1) .menu-item:nth-child(1) .menu-icon {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}

.menu-group:nth-child(1) .menu-item:nth-child(2) .menu-icon {
  background: linear-gradient(135deg, var(--secondary) 0%, #A78BFA 100%);
}

.menu-group:nth-child(1) .menu-item:nth-child(3) .menu-icon {
  background: linear-gradient(135deg, var(--accent-blue) 0%, #74C0FC 100%);
}

.menu-group:nth-child(2) .menu-item:nth-child(1) .menu-icon {
  background: linear-gradient(135deg, var(--accent-orange) 0%, #FFD43B 100%);
}

.menu-group:nth-child(2) .menu-item:nth-child(2) .menu-icon {
  background: linear-gradient(135deg, var(--accent-green) 0%, #63E6BE 100%);
}

.menu-group:nth-child(3) .menu-item:nth-child(1) .menu-icon {
  background: linear-gradient(135deg, #667EA5 0%, #8B9DC3 100%);
}

.menu-group:nth-child(3) .menu-item:nth-child(2) .menu-icon {
  background: linear-gradient(135deg, #F06595 0%, #FAA2C1 100%);
}

.menu-group:nth-child(3) .menu-item:nth-child(3) .menu-icon {
  background: linear-gradient(135deg, #868E96 0%, #ADB5BD 100%);
}

.menu-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.2;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-right: 12rpx;
  line-height: 1;
}

.menu-status {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 12rpx;
  line-height: 1.2;
}

.menu-status.set {
  color: var(--accent-green);
}

.menu-status.unset {
  color: var(--text-secondary);
}

.logout-section {
  margin: 40rpx 32rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border);
  line-height: 1;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}