page {
  --primary: #FF6B6B;
  --primary-light: #FF8E8E;
  --primary-dark: #E55555;
  --secondary: #845EF7;
  --accent-green: #38D9A9;
  --accent-blue: #4DABF7;
  --accent-orange: #FFA94D;
  --bg: #F8F9FA;
  --card: #FFFFFF;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --text-tertiary: #B2BEC3;
  --border: #F1F3F5;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 32rpx;
  background: var(--bg);
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
  line-height: 1;
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--bg);
  color: var(--text-secondary);
  font-size: 26rpx;
  border-radius: var(--radius-xl);
  border: none;
  line-height: 1;
}

.hot-tags {
  padding: 32rpx;
  background: var(--card);
  margin: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.tags-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.3;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, rgba(132, 94, 247, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(132, 94, 247, 0.2);
}

.tag-item text {
  font-size: 26rpx;
  color: var(--secondary);
  font-weight: 500;
  line-height: 1;
}

.tag-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  line-height: 1;
}

.category-filter {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border);
}

.category-item.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.category-item text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  line-height: 1;
}

.category-item.active text {
  color: #FFFFFF;
  font-weight: 600;
}

.result-list {
  padding: 0 32rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.order-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.order-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.order-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xl);
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1;
}

.status-1 {
  background: rgba(255, 107, 107, 0.1);
  color: var(--primary);
}

.status-2 {
  background: rgba(77, 171, 247, 0.1);
  color: var(--accent-blue);
}

.status-3 {
  background: rgba(56, 217, 169, 0.1);
  color: var(--accent-green);
}

.status-4 {
  background: rgba(134, 142, 150, 0.1);
  color: #868E96;
}

.order-content {
  margin-bottom: 16rpx;
}

.order-content text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.order-reward {
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--accent-orange) 0%, #FFD43B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}