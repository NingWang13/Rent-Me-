.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-top: 88rpx;
  padding-bottom: 40rpx;
}

.group-info-card {
  background: var(--card);
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.group-info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--secondary) 0%, #A78BFA 100%);
}

.group-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.group-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--secondary) 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.group-details {
  flex: 1;
}

.group-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.group-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.members-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.member-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-card {
  background: var(--card);
  padding: 24rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-blue) 0%, #74C0FC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.member-role {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.role-badge {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-xl);
}

.role-1 {
  background: rgba(255, 107, 107, 0.1);
}

.role-2 {
  background: rgba(132, 94, 247, 0.1);
}

.role-3 {
  background: rgba(178, 190, 195, 0.1);
}

.role-text {
  font-size: 22rpx;
  font-weight: 600;
}

.role-1 .role-text {
  color: var(--primary);
}

.role-2 .role-text {
  color: var(--secondary);
}

.role-3 .role-text {
  color: var(--text-tertiary);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
