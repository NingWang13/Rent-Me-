<nav-bar title="设置支付密码" showBack="{{true}}" />
<view class="container">
  <view class="step-indicator">
    <view class="step {{step >= 1 ? 'active' : ''}}">
      <view class="step-num">1</view>
      <text class="step-text">输入密码</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}}">
      <view class="step-num">2</view>
      <text class="step-text">确认密码</text>
    </view>
  </view>

  <view class="content">
    <view class="step-content" wx:if="{{step === 1}}">
      <view class="title">设置支付密码</view>
      <view class="desc">请输入6位数字作为支付密码</view>
      <view class="password-input">
        <input class="pwd-input" type="number" maxlength="6" password
               placeholder="请输入6位支付密码"
               value="{{password}}"
               bindinput="onInputPassword" />
      </view>
      <view class="tips">
        <text class="tip-item">密码必须为6位数字</text>
        <text class="tip-item">请勿使用连续数字或重复数字</text>
      </view>
      <button class="next-btn" bindtap="nextStep"
              disabled="{{password.length !== 6 || loading}}">
        下一步
      </button>
    </view>

    <view class="step-content" wx:if="{{step === 2}}">
      <view class="title">确认支付密码</view>
      <view class="desc">请再次输入支付密码</view>
      <view class="password-input">
        <input class="pwd-input" type="number" maxlength="6" password
               placeholder="请再次输入6位支付密码"
               value="{{confirmPassword}}"
               bindinput="onInputConfirmPassword" />
      </view>
      <button class="confirm-btn" bindtap="confirmPassword"
              disabled="{{confirmPassword.length !== 6 || loading}}">
        确认
      </button>
      <button class="back-btn" bindtap="goBack">返回上一步</button>
    </view>
  </view>
</view>
