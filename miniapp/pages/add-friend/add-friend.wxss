.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-top: 88rpx;
  padding-bottom: 40rpx;
}

.search-section {
  padding: 24rpx 32rpx;
  position: sticky;
  top: 88rpx;
  z-index: 10;
  background: var(--bg);
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--card);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.3s;
}

.search-box:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(255, 107, 107, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-btn {
  background: var(--bg);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-md);
  transition: all 0.3s;
}

.search-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.btn-text {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
}

.search-btn.active .btn-text {
  color: #FFFFFF;
}

.add-methods {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.method-card {
  background: var(--card);
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.3s;
}

.method-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.method-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.method-icon-wrapper.scan {
  background: linear-gradient(135deg, var(--accent-blue) 0%, #74C0FC 100%);
}

.method-icon-wrapper.contacts {
  background: linear-gradient(135deg, var(--accent-green) 0%, #20C997 100%);
}

.method-icon-wrapper.share {
  background: linear-gradient(135deg, var(--secondary) 0%, #A78BFA 100%);
}

.method-icon {
  font-size: 40rpx;
}

.method-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.method-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.method-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.method-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-count, .friend-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  background: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xl);
  min-width: 32rpx;
  text-align: center;
}

.badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.user-list, .request-list, .friend-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.user-card, .request-card, .friend-card {
  background: var(--card);
  padding: 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.user-info, .request-info, .friend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.apply-message {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-action, .request-actions, .friend-actions {
  flex-shrink: 0;
}

.add-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.friend-badge {
  background: rgba(56, 217, 169, 0.1);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-md);
}

.badge-text {
  font-size: 22rpx;
  color: var(--accent-green);
  font-weight: 500;
}

.action-btn {
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  font-weight: 600;
}

.action-btn.accept {
  background: linear-gradient(135deg, var(--accent-green) 0%, #20C997 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(56, 217, 169, 0.3);
}

.action-btn.reject {
  background: var(--bg);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.action-btn.chat {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.modal-content {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-tertiary);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  background: var(--bg);
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  height: 160rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: var(--bg);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}
