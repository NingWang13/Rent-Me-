.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-top: 88rpx;
  padding-bottom: 40rpx;
}

.form-section {
  padding: 20rpx 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.input-wrapper, .textarea-wrapper {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border);
  transition: all 0.3s;
}

.input-wrapper:focus-within, .textarea-wrapper:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 3rpx rgba(255, 107, 107, 0.1);
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.input-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.form-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  height: 140rpx;
  line-height: 1.5;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.char-count.warning {
  color: var(--primary);
  font-weight: 600;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.option-card {
  background: var(--card);
  padding: 20rpx 12rpx;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border: 2rpx solid var(--border);
  transition: all 0.3s;
}

.option-card:active {
  transform: scale(0.95);
}

.option-card.active {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 143, 143, 0.1) 100%);
  box-shadow: 0 3rpx 12rpx rgba(255, 107, 107, 0.2);
}

.option-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.option-card.active .option-icon-wrapper {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  box-shadow: 0 3rpx 10rpx rgba(255, 107, 107, 0.3);
}

.option-icon {
  font-size: 28rpx;
}

.option-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.option-card.active .option-text {
  color: var(--primary);
  font-weight: 600;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.option-row {
  background: var(--card);
  padding: 20rpx;
  border-radius: var(--radius-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid var(--border);
  transition: all 0.3s;
}

.option-row:active {
  transform: scale(0.98);
}

.option-row.active {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 143, 143, 0.1) 100%);
}

.option-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.option-row-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-row-icon-wrapper.open {
  background: linear-gradient(135deg, var(--accent-green) 0%, #20C997 100%);
}

.option-row-icon-wrapper.verify {
  background: linear-gradient(135deg, var(--accent-blue) 0%, #74C0FC 100%);
}

.option-row-icon-wrapper.closed {
  background: linear-gradient(135deg, var(--text-tertiary) 0%, #9CA3AF 100%);
}

.option-row-icon {
  font-size: 28rpx;
}

.option-row-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.option-row-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.option-row-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.radio-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.radio-icon.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-badge {
  background: var(--primary);
  padding: 3rpx 10rpx;
  border-radius: var(--radius-xl);
  min-width: 28rpx;
  text-align: center;
}

.badge-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.select-all {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.friend-list {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.friend-card {
  background: var(--card);
  padding: 16rpx 20rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid var(--border);
  transition: all 0.3s;
}

.friend-card.selected {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.05) 0%, rgba(255, 143, 143, 0.05) 100%);
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.check-icon {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.friend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.submit-section {
  padding: 24rpx 28rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -3rpx 12rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.submit-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.4);
}

.submit-btn.disabled {
  background: var(--bg);
  color: var(--text-tertiary);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.submit-btn.disabled .btn-text {
  color: var(--text-tertiary);
}
