<nav-bar title="订单详情" showBack="{{true}}" />
<view class="container">
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="detail-content" wx:elif="{{order}}">
    <view class="order-status-hero">
      <text class="status-icon">{{order.statusIcon}}</text>
      <text class="status-text">{{order.statusText}}</text>
    </view>

    <view class="order-info-card">
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务类型</text>
        <text class="info-value">{{order.serviceType}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单金额</text>
        <text class="info-value price">¥{{order.amount}}</text>
      </view>
      <view class="info-row" wx:if="{{order.actualAmount}}">
        <text class="info-label">实付金额</text>
        <text class="info-value price">¥{{order.actualAmount}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paymentTime}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.paymentTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.completeTime}}">
        <text class="info-label">完成时间</text>
        <text class="info-value">{{order.completeTime}}</text>
      </view>
    </view>

    <view class="order-content-card">
      <text class="card-title">服务详情</text>
      <text class="order-title">{{order.title}}</text>
      <text class="order-desc">{{order.content || '暂无描述'}}</text>
    </view>

    <view class="action-section">
      <button class="action-btn primary" wx:if="{{order.status === 1}}" bindtap="onPay">
        <text class="btn-text">立即支付</text>
      </button>
      <button class="action-btn secondary" wx:if="{{order.status === 2}}" bindtap="onConfirmComplete">
        <text class="btn-text">确认完成</text>
      </button>
      <button class="action-btn danger" wx:if="{{order.status === 1 || order.status === 2}}" bindtap="onCancel">
        <text class="btn-text">取消订单</text>
      </button>
    </view>
  </view>

  <view class="empty-container" wx:else>
    <text class="empty-icon">📦</text>
    <text class="empty-text">订单不存在或已删除</text>
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>
</view>
