.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-top: 88rpx;
  padding-bottom: 40rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 160rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.detail-content {
  padding: 24rpx 32rpx;
}

.order-status-hero {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 60rpx 0;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.order-status-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
}

.status-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.order-info-card {
  background: var(--card);
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.order-info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--accent-blue) 0%, #74C0FC 100%);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-value.price {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 700;
}

.order-content-card {
  background: var(--card);
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.order-content-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--secondary) 0%, #A78BFA 100%);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.order-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.order-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.action-section {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}

.action-btn.secondary {
  background: linear-gradient(135deg, var(--secondary) 0%, #A78BFA 100%);
  box-shadow: 0 8rpx 24rpx rgba(132, 94, 247, 0.3);
}

.action-btn.danger {
  background: var(--card);
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.danger .btn-text {
  color: var(--text-secondary);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.back-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}
