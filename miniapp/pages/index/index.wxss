page {
  --primary: #FF6B6B;
  --primary-light: #FF8E8E;
  --primary-dark: #E55555;
  --secondary: #845EF7;
  --accent-green: #38D9A9;
  --accent-blue: #4DABF7;
  --accent-orange: #FFA94D;
  --bg: #F8F9FA;
  --card: #FFFFFF;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --text-tertiary: #B2BEC3;
  --border: #F1F3F5;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.user-greeting {
  flex: 1;
  z-index: 1;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  z-index: 1;
}

.elder-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.toggle-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.banners {
  margin: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.banner-image {
  width: 100%;
  height: 320rpx;
}

.user-section {
  margin: 0 32rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.user-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 60rpx;
  background: var(--border);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: 1;
}

.login-prompt {
  margin: 0 32rpx 24rpx;
  padding: 48rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  display: flex;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  line-height: 1;
}

.quick-actions {
  margin: 0 32rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.actions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

.action-icon::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -20%;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.action-item:nth-child(1) .action-icon {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.action-item:nth-child(2) .action-icon {
  background: linear-gradient(135deg, #845EF7 0%, #A78BFA 100%);
}

.action-item:nth-child(3) .action-icon {
  background: linear-gradient(135deg, #38D9A9 0%, #63E6BE 100%);
}

.action-item:nth-child(4) .action-icon {
  background: linear-gradient(135deg, #4DABF7 0%, #74C0FC 100%);
}

.icon-symbol {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 400;
  line-height: 1;
}

.action-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
}

.mutual-helps {
  margin: 0 32rpx;
}

.help-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.help-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.help-user {
  display: flex;
  align-items: center;
}

.help-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--secondary) 100%);
  flex-shrink: 0;
}

.help-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  line-height: 1.2;
}

.help-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.help-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.help-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.help-reward {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  line-height: 1;
}