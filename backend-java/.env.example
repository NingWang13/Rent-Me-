# ============================================
# 社区互助平台 - 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env 或配置到部署环境变量中
# 2. 生产环境必须修改所有标记为【必须】的变量
# 3. 开发环境可使用默认值（标记为【可选】的变量）
# 4. 切勿将 .env 文件提交到版本控制系统
# ============================================

# ===== 数据库配置 =====
DB_HOST=localhost                          # 【可选】数据库主机地址
DB_PORT=3306                               # 【可选】数据库端口
DB_NAME=community_platform                 # 【可选】数据库名称
DB_USERNAME=root                           # 【必须】数据库用户名
DB_PASSWORD=your-secure-db-password        # 【必须】数据库密码（至少16位，含大小写字母+数字+特殊字符）
DB_USE_SSL=false                           # 【必须-生产】生产环境必须设为true
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false        # 【必须-生产】生产环境必须设为false
DB_MIN_IDLE=5                              # 【可选】连接池最小空闲连接数
DB_MAX_POOL_SIZE=20                        # 【可选】连接池最大连接数

# ===== Redis 配置 =====
REDIS_HOST=localhost                       # 【可选】Redis主机地址
REDIS_PORT=6379                            # 【可选】Redis端口
REDIS_PASSWORD=your-secure-redis-password  # 【必须】Redis密码（至少16位）
REDIS_DB=0                                 # 【可选】Redis数据库编号

# ===== RabbitMQ 配置（order-service） =====
RABBITMQ_HOST=localhost                    # 【可选】RabbitMQ主机地址
RABBITMQ_PORT=5672                         # 【可选】RabbitMQ端口
RABBITMQ_USERNAME=rabbitmq-admin           # 【必须】RabbitMQ用户名
RABBITMQ_PASSWORD=your-secure-rmq-password # 【必须】RabbitMQ密码
RABBITMQ_VHOST=/                           # 【可选】RabbitMQ虚拟主机

# ===== JWT 配置 =====
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long-for-security  # 【必须】JWT签名密钥（至少32字符）
JWT_EXPIRATION=86400000                    # 【可选】JWT过期时间（毫秒），默认24小时

# ===== 微信小程序配置 =====
WECHAT_APP_ID=wx-your-app-id               # 【必须】微信小程序AppID
WECHAT_APP_SECRET=your-wechat-app-secret   # 【必须】微信小程序AppSecret

# ===== 网关配置 =====
GATEWAY_PORT=8080                          # 【可选】网关服务端口
USER_SERVICE_URL=http://localhost:8081     # 【可选】用户服务地址
ORDER_SERVICE_URL=http://localhost:8082    # 【可选】订单服务地址
PAYMENT_SERVICE_URL=http://localhost:8083  # 【可选】支付服务地址
MESSAGE_SERVICE_URL=http://localhost:8084  # 【可选】消息服务地址
CREDIT_SERVICE_URL=http://localhost:8085   # 【可选】信用服务地址
ACTIVITY_SERVICE_URL=http://localhost:8086 # 【可选】活动服务地址

# ===== CORS 配置 =====
CORS_ALLOWED_ORIGINS=https://*.wxapp.qq.com,http://localhost:*  # 【必须-生产】生产环境必须移除localhost

# ===== 日志配置 =====
LOG_LEVEL_ROOT=INFO                        # 【可选】根日志级别
LOG_LEVEL_APP=INFO                         # 【可选】应用日志级别

# ===== Actuator 监控配置 =====
ACTUATOR_HEALTH_SHOW_DETAILS=when-authorized  # 【必须-生产】生产环境必须设为when-authorized或never
ACTUATOR_SECURITY_ENABLED=true             # 【必须】是否启用Actuator安全保护
